# Supabase — copy to .env and fill in. Never commit .env.
# Project URL and publishable (anon) key are safe for the browser.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Direct Postgres connection — SERVER / MIGRATIONS ONLY, never exposed to the browser.
# Percent-encode special characters in the password (space = %20, & = %26).
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"
